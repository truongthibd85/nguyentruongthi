---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
---

<BaseLayout title="Giới thiệu | Thi Nguyễn (Leon)" description="Tìm hiểu về Thi Nguyễn (Leon) - Đồng sáng lập & Giám đốc Đối tác tại Sticker Factory">
  <div class="pt-24 pb-16 bg-gradient-to-br from-light via-white to-orange-50">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-dark mb-4">Về tôi</h1>
      <p class="text-gray-600">Hành trình từ một ý tưởng đến công ty in ấn B2B hàng đầu</p>
    </div>
  </div>
  <About />
</BaseLayout>