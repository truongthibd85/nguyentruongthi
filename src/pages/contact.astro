---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout title="Liên hệ | Thi Nguyễn (Leon)" description="Liên hệ Thi Nguyễn (Leon) - Co-Founder & Partner Director tại Sticker Factory">
  <div class="pt-24 pb-16 bg-gradient-to-br from-light via-white to-orange-50">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-dark mb-4">Liên hệ</h1>
      <p class="text-gray-600">Hãy kết nối với tôi để thảo luận về giải pháp in ấn cho thương hiệu của bạn</p>
    </div>
  </div>
  <Contact />
</BaseLayout>