---
import BaseLayout from '../layouts/BaseLayout.astro';
import Services from '../components/Services.astro';
---

<BaseLayout title="Dịch vụ | Thi Nguyễn (Leon)" description="Dịch vụ in ấn theo yêu cầu - Sticker, tem nhãn, bao bì, giải pháp B2B tại Sticker Factory">
  <div class="pt-24 pb-16 bg-gradient-to-br from-light via-white to-orange-50">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-dark mb-4">Dịch vụ</h1>
      <p class="text-gray-600">Giải pháp in ấn theo yêu cầu cho cá nhân, local brand, SME và khách hàng B2B</p>
    </div>
  </div>
  <Services />
</BaseLayout>