---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
---

<BaseLayout title="Kinh nghiệm | Thi Nguyễn (Leon)" description="Hành trình sự nghiệp của Thi Nguyễn (Leon) - Từ Vietnam Outfitter 2015 đến Sticker Factory 2020">
  <div class="pt-24 pb-16 bg-gradient-to-br from-light via-white to-orange-50">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-dark mb-4">Kinh nghiệm</h1>
      <p class="text-gray-600">9+ năm xây dựng thương hiệu và phát triển doanh nghiệp</p>
    </div>
  </div>
  <Timeline />
</BaseLayout>