---
---

<section class="min-h-screen flex items-center justify-center bg-background pt-20 relative overflow-hidden">
  <!-- Dot pattern background -->
  <div class="absolute inset-0 bg-dot-pattern"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-16 text-center relative z-10">
    <!-- Badge -->
    <div class="mb-6 inline-flex items-center gap-2">
      <span class="font-label text-label-md text-on-surface-variant border-2 border-outline px-4 py-1.5 rounded-full">
        Master of Sticker
      </span>
    </div>

    <!-- Name -->
    <h1 class="font-heading font-bold text-display-lg md:text-display-lg-mobile text-on-background mb-4">
      Thi Nguyễn
      <span class="text-primary">(Leon)</span>
    </h1>

    <!-- Title -->
    <p class="font-body text-body-lg text-on-surface-variant mb-8 max-w-2xl mx-auto">
      <span data-lang="vi">Đồng sáng lập & Giám đốc Đối tác tại Sticker Factory</span>
      <span data-lang="en">Co-Founder & Partner Director at Sticker Factory</span>
    </p>

    <!-- Tagline -->
    <p class="font-body text-body-md text-on-surface-variant/70 mb-12 max-w-xl mx-auto">
      <span data-lang="vi">Giải pháp sticker, tem nhãn, bao bì & in ấn theo yêu cầu cho thương hiệu của bạn</span>
      <span data-lang="en">Custom sticker, labels, packaging & printing solutions for your brand</span>
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/about" class="btn-primary">
        <span data-lang="vi">Khám phá thêm</span>
        <span data-lang="en">Learn More</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="/contact" class="btn-outline">
        <span data-lang="vi">Liên hệ ngay</span>
        <span data-lang="en">Contact Me</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
    </div>

    <!-- Social links -->
    <div class="mt-16 flex justify-center items-center gap-6">
      <a href="https://www.linkedin.com/in/nguyentruongthi" target="_blank" rel="noopener noreferrer"
         class="font-label text-label-md text-on-surface-variant hover:text-primary transition-colors duration-200">LinkedIn</a>
      <span class="w-1 h-1 bg-outline rounded-full"></span>
      <a href="https://www.instagram.com/stickermanvn" target="_blank" rel="noopener noreferrer"
         class="font-label text-label-md text-on-surface-variant hover:text-primary transition-colors duration-200">Instagram</a>
      <span class="w-1 h-1 bg-outline rounded-full"></span>
      <a href="https://stickerfactory.vn" target="_blank" rel="noopener noreferrer"
         class="font-label text-label-md text-on-surface-variant hover:text-primary transition-colors duration-200">Website</a>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-12">
      <div class="inline-flex flex-col items-center gap-2 text-on-surface-variant/50">
        <span class="font-label text-label-sm">Scroll</span>
        <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>
  </div>
</section>