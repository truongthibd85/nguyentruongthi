---
---

<section id="home" class="min-h-screen flex items-center pt-20 relative overflow-hidden bg-background">
  <!-- Decorative pattern -->
  <div class="absolute inset-0 pattern-dots"></div>
  <!-- Decorative circles -->
  <div class="absolute top-20 right-10 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-10 w-48 h-48 bg-tertiary/10 rounded-full blur-3xl"></div>

  <div class="container-custom relative z-10 py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Content -->
      <div class="space-y-6">
        <!-- Badge -->
        <div class="reveal animate-fade-in-left">
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-surface-container rounded-full text-sm font-semibold text-on-surface">
            <span class="w-2 h-2 bg-success rounded-full animate-pulse"></span>
            <span data-lang="vi">Đang hoạt động</span>
            <span data-lang="en">Available for work</span>
          </span>
        </div>

        <!-- Name -->
        <h1 class="reveal animate-fade-in-left stagger-1 font-heading font-bold text-display-lg-mobile lg:text-display-lg text-on-surface leading-tight">
          Thi Nguyễn <span class="text-primary">(Leon)</span>
        </h1>

        <!-- Title -->
        <p class="reveal animate-fade-in-left stagger-2 font-body text-body-lg text-on-surface-variant leading-relaxed">
          <span data-lang="vi">Đồng sáng lập & Giám đốc Đối tác tại Sticker Factory</span>
          <span data-lang="en">Co-Founder & Partner Director at Sticker Factory</span>
        </p>

        <!-- Tagline -->
        <p class="reveal animate-fade-in-left stagger-3 font-body text-body-md text-on-surface-variant/70">
          <span data-lang="vi">Giải pháp sticker, tem nhãn, bao bì & in ấn theo yêu cầu cho thương hiệu của bạn</span>
          <span data-lang="en">Custom sticker, labels, packaging & printing solutions for your brand</span>
        </p>

        <!-- CTA Buttons -->
        <div class="reveal animate-fade-in-left stagger-4 flex flex-wrap gap-4">
          <a href="#contact" class="btn-primary">
            <span class="material-symbols-outlined">mail</span>
            <span data-lang="vi">Liên hệ ngay</span>
            <span data-lang="en">Contact Me</span>
          </a>
          <a href="#services" class="btn-outline">
            <span class="material-symbols-outlined">apps</span>
            <span data-lang="vi">Xem dịch vụ</span>
            <span data-lang="en">View Services</span>
          </a>
        </div>

        <!-- Quick stats -->
        <div class="reveal animate-fade-in-left stagger-5 flex flex-wrap gap-8 pt-4">
          {[
            { number: '9+', label: 'Năm kinh nghiệm', labelEn: 'Years' },
            { number: '500+', label: 'Khách hàng', labelEn: 'Clients' },
            { number: '2020', label: 'Thành lập công ty', labelEn: 'Founded' },
          ].map(stat => (
            <div class="text-center">
              <div class="font-heading font-bold text-2xl text-primary">{stat.number}</div>
              <div class="font-body text-sm text-on-surface-variant">
                <span data-lang="vi">{stat.label}</span>
                <span data-lang="en">{stat.labelEn}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Avatar / Visual -->
      <div class="reveal animate-fade-in-right relative">
        <div class="relative flex justify-center">
          <!-- Avatar with decorative rings -->
          <div class="relative">
            <!-- Decorative rings -->
            <div class="absolute -top-4 -right-4 w-24 h-24 bg-tertiary/30 rounded-full -z-10"></div>
            <div class="absolute -bottom-4 -left-4 w-20 h-20 bg-primary/20 rounded-full -z-10"></div>

            <!-- Avatar image - circular crop -->
            <div class="w-72 h-72 lg:w-96 lg:h-96 rounded-full overflow-hidden border-4 border-white shadow-2xl">
              <img
                src="https://cdn.hstatic.net/files/1000090040/file/1._thi_grey_bg_ea4df9a629d14942a9ecdd3a14366b8d_1024x1024.jpg"
                alt="Thi Nguyễn (Leon)"
                class="w-full h-full object-cover object-center"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>