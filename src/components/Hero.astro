---

<section class="min-h-screen flex items-center justify-center bg-brand-white pt-20 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-10 left-10 w-32 h-32 bg-brand-red rounded-full"></div>
    <div class="absolute bottom-20 right-20 w-48 h-48 bg-brand-yellow rounded-full"></div>
    <div class="absolute top-1/3 right-1/4 w-24 h-24 bg-brand-green rounded-full"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 text-center relative z-10">
    <div class="mb-6">
      <span class="inline-block px-5 py-2 bg-brand-red text-brand-white text-sm font-bold rounded-full tracking-wide">
        <span data-lang="vi">Master of Sticker</span>
        <span data-lang="en">Master of Sticker</span>
      </span>
    </div>
    <h1 class="text-5xl md:text-7xl font-heading font-bold mb-4 text-brand-black">
      Thi Nguyễn
      <span class="text-brand-red">(Leon)</span>
    </h1>
    <p class="text-xl md:text-2xl text-brand-black/70 mb-8 max-w-2xl mx-auto leading-relaxed font-body">
      <span data-lang="vi">Đồng sáng lập & Giám đốc Đối tác tại Sticker Factory</span>
      <span data-lang="en">Co-Founder & Partner Director at Sticker Factory</span>
    </p>
    <p class="text-lg text-brand-black/50 mb-12 max-w-xl mx-auto font-body">
      <span data-lang="vi">Giải pháp sticker, tem nhãn, bao bì & in ấn theo yêu cầu cho thương hiệu của bạn</span>
      <span data-lang="en">Custom sticker, labels, packaging & printing solutions for your brand</span>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/about" class="btn-primary">
        <span data-lang="vi">Khám phá thêm</span>
        <span data-lang="en">Learn More</span>
      </a>
      <a href="/contact" class="btn-outline">
        <span data-lang="vi">Liên hệ ngay</span>
        <span data-lang="en">Contact Me</span>
      </a>
    </div>
    <div class="mt-16 flex justify-center gap-6">
      <a href="https://www.linkedin.com/in/nguyentruongthi" target="_blank" rel="noopener noreferrer"
         class="text-brand-black/40 hover:text-brand-red transition-colors text-sm font-medium">LinkedIn</a>
      <span class="text-brand-black/20">|</span>
      <a href="https://www.instagram.com/stickermanvn" target="_blank" rel="noopener noreferrer"
         class="text-brand-black/40 hover:text-brand-red transition-colors text-sm font-medium">Instagram</a>
      <span class="text-brand-black/20">|</span>
      <a href="https://stickerfactory.vn" target="_blank" rel="noopener noreferrer"
         class="text-brand-black/40 hover:text-brand-red transition-colors text-sm font-medium">Website</a>
    </div>
    <div class="mt-12">
      <svg class="mx-auto w-6 h-6 text-brand-red animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>