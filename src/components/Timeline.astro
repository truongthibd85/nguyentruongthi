---
const milestones = [
  {
    year: '2015',
    title: 'Vietnam Outfitter',
    subtitle: 'Nhà sáng lập',
    subtitleEn: 'Founder',
    description: 'Thành lập Vietnam Outfitter – thương hiệu lifestyle tập trung vào sản phẩm du lịch, phượt, xe máy và cộng đồng.',
    descriptionEn: 'Founded Vietnam Outfitter, a lifestyle brand focused on travel, outdoor, motorbike and community-driven products.',
  },
  {
    year: '2016',
    title: 'Online-to-Offline',
    subtitle: 'Mô hình bán lẻ',
    subtitleEn: 'Retail Model',
    description: 'Phát triển mô hình bán hàng online kết hợp cửa hàng offline tại TP. Hồ Chí Minh.',
    descriptionEn: 'Developed the online-to-offline retail model and opened a customer experience store in Ho Chi Minh City.',
  },
  {
    year: '2018',
    title: 'Sticker Factory',
    subtitle: 'Đồng sáng lập',
    subtitleEn: 'Co-Founder',
    description: 'Chuyển đổi mô hình từ Vietnam Outfitter sang Sticker Factory, tập trung vào sticker, tem nhãn và in ấn theo yêu cầu.',
    descriptionEn: 'Transitioned from Vietnam Outfitter into Sticker Factory, focusing on stickers, labels and custom printing.',
  },
  {
    year: '06/2020',
    title: 'Công ty TNHH',
    subtitle: 'Đồng sáng lập & Giám đốc Đối tác',
    subtitleEn: 'Co-Founder & Partner Director',
    description: 'Chính thức thành lập pháp nhân Công ty TNHH Nhà Máy Sticker.',
    descriptionEn: 'Officially established Sticker Factory Company Limited.',
  },
  {
    year: '2020–Nay',
    title: 'Sticker Factory',
    subtitle: 'Đồng sáng lập & Giám đốc Đối tác',
    subtitleEn: 'Co-Founder & Partner Director',
    description: 'Phát triển Sticker Factory thành công ty in ấn theo yêu cầu và giải pháp in ấn B2B phục vụ local brand, SME và khách hàng doanh nghiệp.',
    descriptionEn: 'Developing Sticker Factory as a custom printing and B2B printing solutions company serving local brands, SMEs and corporate clients.',
  },
];
---

<section class="section-padding bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="section-title">
        <span data-lang="vi">Hành trình</span>
        <span data-lang="en">Journey</span>
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        <span data-lang="vi">Từ một ý tưởng sáng tạo đến công ty in ấn B2B hàng đầu</span>
        <span data-lang="en">From a creative idea to a leading B2B printing company</span>
      </p>
    </div>

    <div class="relative">
      <div class="absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-brand-red/20 hidden md:block"></div>

      <div class="space-y-6 md:space-y-10">
        {milestones.map((item, index) => (
          <div class={`relative flex flex-col md:flex-row items-center gap-6 md:gap-8 ${index % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
            <div class="flex-1">
              <div class="bg-brand-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow text-left md:text-right">
                <span class="inline-block px-3 py-1 bg-brand-red text-brand-white text-xs font-bold rounded-full mb-3">
                  {item.year}
                </span>
                <h3 class="font-heading text-xl font-bold text-brand-black mb-1">{item.title}</h3>
                <p class="text-brand-red text-sm font-medium mb-3">
                  <span data-lang="vi">{item.subtitle}</span>
                  <span data-lang="en">{item.subtitleEn}</span>
                </p>
                <p class="text-gray-600 text-sm leading-relaxed">
                  <span data-lang="vi">{item.description}</span>
                  <span data-lang="en">{item.descriptionEn}</span>
                </p>
              </div>
            </div>

            <div class="hidden md:flex items-center justify-center flex-shrink-0">
              <div class="w-4 h-4 rounded-full border-4 border-brand-white shadow bg-brand-red"></div>
            </div>

            <div class="flex-1">
              <div class="bg-brand-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <span class="inline-block px-3 py-1 bg-brand-red/10 text-brand-red text-xs font-bold rounded-full mb-3">
                  {item.year}
                </span>
                <h3 class="font-heading text-xl font-bold text-brand-black mb-1">{item.title}</h3>
                <p class="text-brand-red text-sm font-medium mb-3">
                  <span data-lang="vi">{item.subtitle}</span>
                  <span data-lang="en">{item.subtitleEn}</span>
                </p>
                <p class="text-gray-600 text-sm leading-relaxed">
                  <span data-lang="vi">{item.description}</span>
                  <span data-lang="en">{item.descriptionEn}</span>
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>