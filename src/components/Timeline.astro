---
const milestones = [
  {
    year: '05/2015',
    title: 'Vietnam Outfitter',
    subtitle: 'Nhà sáng lập / Founder',
    descriptionEn: 'Founded Vietnam Outfitter, a lifestyle brand focused on travel, outdoor, motorbike and community-driven products.',
    descriptionVi: 'Thành lập Vietnam Outfitter – thương hiệu lifestyle tập trung vào sản phẩm du lịch, phượt, xe máy và cộng đồng.',
    type: 'experience',
  },
  {
    year: '2016',
    title: 'Online-to-Offline',
    subtitle: 'Mô hình bán hàng / Retail Model',
    descriptionEn: 'Developed the online-to-offline retail model and opened a customer experience store in Ho Chi Minh City.',
    descriptionVi: 'Phát triển mô hình bán hàng online kết hợp cửa hàng offline tại TP. Hồ Chí Minh.',
    type: 'milestone',
  },
  {
    year: '2018',
    title: 'Sticker Factory',
    subtitle: 'Đồng sáng lập / Co-Founder',
    descriptionEn: 'Transitioned from Vietnam Outfitter into Sticker Factory, focusing on stickers, labels, custom printing and creative brand products.',
    descriptionVi: 'Chuyển đổi mô hình từ Vietnam Outfitter sang Sticker Factory, tập trung vào sticker, tem nhãn và in ấn theo yêu cầu.',
    type: 'transition',
  },
  {
    year: '06/2020',
    title: 'Công ty TNHH Nhà Máy Sticker',
    subtitle: 'Đồng sáng lập & Giám đốc Đối tác',
    descriptionEn: 'Officially established Sticker Factory Company Limited, marking the transition into a formal printing and production company.',
    descriptionVi: 'Chính thức thành lập pháp nhân Công ty TNHH Nhà Máy Sticker – bước chuyển từ thương hiệu sticker sáng tạo sang công ty in ấn chuyên nghiệp.',
    type: 'company',
  },
  {
    year: '2020 – Nay',
    title: 'Sticker Factory',
    subtitle: 'Đồng sáng lập & Giám đốc Đối tác',
    descriptionEn: 'Developed Sticker Factory as a custom printing and B2B printing solutions company serving local brands, SMEs, creators, communities and corporate clients.',
    descriptionVi: 'Phát triển Sticker Factory thành công ty in ấn theo yêu cầu và giải pháp in ấn B2B phục vụ local brand, SME, creator và khách hàng doanh nghiệp.',
    type: 'current',
  },
];
---

<section class="section-padding bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="section-title">Hành trình</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Từ một ý tưởng sáng tạo đến công ty in ấn B2B hàng đầu
      </p>
    </div>

    <div class="relative">
      <div class="absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-orange-200 hidden md:block"></div>

      <div class="space-y-8 md:space-y-12">
        {milestones.map((item, index) => (
          <div class={`relative flex flex-col md:flex-row items-center gap-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <div class="flex-1 text-right md:text-right">
              <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <span class="inline-block px-3 py-1 bg-primary text-white text-xs font-bold rounded-full mb-3">
                  {item.year}
                </span>
                <h3 class="font-heading text-xl font-bold text-dark mb-1">{item.title}</h3>
                <p class="text-primary text-sm font-medium mb-3">{item.subtitle}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{item.descriptionVi}</p>
              </div>
            </div>

            <div class="hidden md:flex items-center justify-center w-4">
              <div class={`w-4 h-4 rounded-full border-4 border-white shadow ${item.type === 'company' || item.type === 'current' ? 'bg-primary' : item.type === 'milestone' ? 'bg-secondary' : 'bg-orange-400'}`}></div>
            </div>

            <div class="flex-1">
              <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow md:text-left">
                <span class="inline-block px-3 py-1 bg-gray-100 text-gray-600 text-xs font-bold rounded-full mb-3">
                  {item.year}
                </span>
                <h3 class="font-heading text-xl font-bold text-dark mb-1">{item.title}</h3>
                <p class="text-gray-500 text-sm font-medium mb-3">{item.subtitle}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{item.descriptionEn}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>