---

<div id="floating-contact" class="fixed bottom-6 right-6 z-50 flex flex-col gap-3">
  <!-- Toggle button -->
  <button id="contact-toggle" class="w-14 h-14 bg-primary rounded-full shadow-lg flex items-center justify-center hover:bg-orange-600 transition-all duration-300 hover:scale-110 group">
    <svg id="icon-close" class="w-6 h-6 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
    <svg id="icon-open" class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
    <span class="absolute -top-1 -right-1 w-4 h-4 bg-green-400 rounded-full border-2 border-white animate-pulse"></span>
  </button>

  <!-- Contact options -->
  <div id="contact-menu" class="flex flex-col gap-3 mb-2 opacity-0 translate-y-4 scale-90 transition-all duration-300 pointer-events-none" style="display: none;">
    <!-- Zalo -->
    <a href="https://zalo.me/0989837485" target="_blank" rel="noopener noreferrer"
       class="group flex items-center gap-3 bg-blue-500 text-white px-4 py-3 rounded-full shadow-md hover:bg-blue-600 transition-all hover:scale-105">
      <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center flex-shrink-0">
        <span class="text-blue-500 font-bold text-sm">Zalo</span>
      </div>
      <span class="font-medium text-sm whitespace-nowrap">Zalo: 0989 83 74 85</span>
    </a>

    <!-- WhatsApp -->
    <a href="https://wa.me/84989837485?text=Xin%20ch%C3%A0o%2C%20t%C3%B4i%20mu%E1%BB%91n%20t%C6%B0%20v%E1%BA%A5n%20v%E1%BB%81%20d%E1%BB%8Bch%20v%E1%BB%A5%20in%20%E1%BA%A5n%20t%E1%BA%A1i%20Sticker%20Factory"
       target="_blank" rel="noopener noreferrer"
       class="group flex items-center gap-3 bg-green-500 text-white px-4 py-3 rounded-full shadow-md hover:bg-green-600 transition-all hover:scale-105">
      <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </div>
      <span class="font-medium text-sm whitespace-nowrap">WhatsApp</span>
    </a>

    <!-- Email -->
    <a href="mailto:truongthinguyen@stickerfactory.vn?subject=T%C6%B0%20v%E1%BA%A5n%20d%E1%BB%8Bch%20v%E1%BB%A5%20in%20%E1%BA%A5n&body=Xin%20ch%C3%A0o%20Anh%2FCh%E1%BB%8B%20Thi%20Nguy%E1%BB%85n%20(Leon)%2C%0A%0AT%C3%B4i%20mu%E1%BB%91n%20t%C6%B0%20v%E1%BA%A5n%20v%E1%BB%81%20d%E1%BB%8Bch%20v%E1%BB%A5%20in%20%E1%BA%A5n%20cho%20th%C6%B0%C6%A1ng%20hi%E1%BB%87u%20c%E1%BB%A7a%20m%C3%ACnh."
       class="group flex items-center gap-3 bg-gray-700 text-white px-4 py-3 rounded-full shadow-md hover:bg-gray-800 transition-all hover:scale-105">
      <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <span class="font-medium text-sm whitespace-nowrap">Gửi Email</span>
    </a>

    <!-- Form tư vấn -->
    <a href="#contact" onclick="document.getElementById('contact-form').scrollIntoView({behavior: 'smooth'}); toggleContactMenu();"
       class="group flex items-center gap-3 bg-primary text-white px-4 py-3 rounded-full shadow-md hover:bg-orange-600 transition-all hover:scale-105">
      <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <span class="font-medium text-sm whitespace-nowrap">Form tư vấn</span>
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById('contact-toggle');
  const menu = document.getElementById('contact-menu');
  const iconClose = document.getElementById('icon-close');
  const iconOpen = document.getElementById('icon-open');
  let isOpen = false;

  function toggleContactMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      menu.style.display = 'flex';
      setTimeout(() => {
        menu.style.opacity = '1';
        menu.style.transform = 'translateY(0) scale(1)';
        menu.style.pointerEvents = 'auto';
      }, 10);
      iconClose.classList.remove('hidden');
      iconOpen.classList.add('hidden');
    } else {
      menu.style.opacity = '0';
      menu.style.transform = 'translateY(16px) scale(0.9)';
      menu.style.pointerEvents = 'none';
      setTimeout(() => {
        menu.style.display = 'none';
      }, 300);
      iconClose.classList.add('hidden');
      iconOpen.classList.remove('hidden');
    }
  }

  toggle?.addEventListener('click', toggleContactMenu);
</script>

<style>
  #contact-menu a:hover > div {
    transform: scale(1.1);
    transition: transform 0.2s ease;
  }
</style>