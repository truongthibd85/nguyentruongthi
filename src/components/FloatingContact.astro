<script is:inline>
  const fabToggle = document.getElementById('fab-toggle');
  const fabMenu = document.getElementById('fab-menu');
  const fabItems = document.getElementById('fab-items');
  let isOpen = false;

  fabToggle?.addEventListener('click', function(e) {
    e.stopPropagation();
    isOpen = !isOpen;
    if (isOpen) {
      fabItems?.classList.remove('hidden');
      fabMenu?.classList.add('active');
    } else {
      fabItems?.classList.add('hidden');
      fabMenu?.classList.remove('active');
    }
  });

  document.addEventListener('click', function(event) {
    if (fabMenu && !fabMenu.contains(event.target)) {
      isOpen = false;
      fabItems?.classList.add('hidden');
      fabMenu.classList.remove('active');
    }
  });

  document.getElementById('fab-form-link')?.addEventListener('click', function(e) {
    isOpen = false;
    fabItems?.classList.add('hidden');
    fabMenu?.classList.remove('active');
  });
</script>