---

<div id="fab-menu" class="fab-menu">
  <!-- FAB toggle -->
  <button id="fab-toggle" class="fab-btn relative" aria-label="Toggle contact menu">
    <span class="material-symbols-outlined fab-icon-open text-2xl">chat</span>
    <span class="material-symbols-outlined fab-icon-close text-2xl">close</span>
    <span class="absolute -top-1 -right-1 w-4 h-4 bg-success rounded-full border-2 border-white animate-pulse"></span>
  </button>

  <!-- Menu items -->
  <div class="fab-child">
    <a href="https://zalo.me/0989837485" target="_blank" rel="noopener noreferrer"
       class="fab-menu-item mb-2" title="Zalo">
      <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0">
        <span class="text-white font-bold text-sm">Zalo</span>
      </div>
      <span class="font-body text-sm font-semibold whitespace-nowrap">Zalo: 0989 83 74 85</span>
    </a>
  </div>

  <div class="fab-child">
    <a href="https://wa.me/84989837485?text=Xin%20ch%C3%A0o%2C%20t%C3%B4i%20mu%E1%BB%91n%20t%C6%B0%20v%E1%BA%A5n%20v%E1%BB%81%20d%E1%BB%8Bch%20v%E1%BB%A5%20in%20%E1%BA%A5n%20t%E1%BA%A1i%20Sticker%20Factory"
       target="_blank" rel="noopener noreferrer" class="fab-menu-item mb-2" title="WhatsApp">
      <div class="w-10 h-10 bg-success rounded-full flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-white">call</span>
      </div>
      <span class="font-body text-sm font-semibold whitespace-nowrap">WhatsApp</span>
    </a>
  </div>

  <div class="fab-child">
    <a href="mailto:truongthinguyen@stickerfactory.vn" class="fab-menu-item mb-2" title="Email">
      <div class="w-10 h-10 bg-secondary rounded-full flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-white">mail</span>
      </div>
      <span class="font-body text-sm font-semibold whitespace-nowrap">
        <span data-lang="vi">Gửi Email</span>
        <span data-lang="en">Send Email</span>
      </span>
    </a>
  </div>

  <div class="fab-child">
    <a href="#contact" class="fab-menu-item" title="Form">
      <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-white">description</span>
      </div>
      <span class="font-body text-sm font-semibold whitespace-nowrap">
        <span data-lang="vi">Form tư vấn</span>
        <span data-lang="en">Contact Form</span>
      </span>
    </a>
  </div>
</div>

<script is:inline>
  const fabToggle = document.getElementById('fab-toggle');
  const fabMenu = document.getElementById('fab-menu');
  fabToggle?.addEventListener('click', function(e) {
    e.stopPropagation();
    fabMenu?.classList.toggle('active');
  });
  document.addEventListener('click', function(event) {
    if (fabMenu && !fabMenu.contains(event.target)) {
      fabMenu.classList.remove('active');
    }
  });
</script>