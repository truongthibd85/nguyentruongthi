---
const navLinks = [
  { href: '/', label: 'Trang chủ', labelEn: 'Home' },
  { href: '/about', label: 'Giới thiệu', labelEn: 'About' },
  { href: '/experience', label: 'Kinh nghiệm', labelEn: 'Experience' },
  { href: '/services', label: 'Dịch vụ', labelEn: 'Services' },
  { href: '/contact', label: 'Liên hệ', labelEn: 'Contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-surface border-b-2 border-on-background">
  <div class="max-w-7xl mx-auto px-6 lg:px-16 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 bg-primary rounded-sm flex items-center justify-center shadow-card group-hover:shadow-card-hover group-active:scale-95 transition-all duration-200">
        <span class="text-on-primary font-heading font-bold text-sm">SF</span>
      </div>
      <div class="hidden sm:block">
        <span class="font-heading font-bold text-lg text-on-background">Sticker Factory</span>
      </div>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map(link => (
        <a href={link.href} class="px-4 py-2 text-label-md font-label text-on-surface-variant hover:text-primary hover:bg-surface-variant rounded-sm transition-colors duration-200">
          <span data-lang="vi">{link.label}</span>
          <span data-lang="en">{link.labelEn}</span>
        </a>
      ))}
      <!-- Language toggle -->
      <button id="lang-toggle" class="lang-toggle ml-2 text-label-sm">
        <span data-lang="vi">EN</span>
        <span data-lang="en">VI</span>
      </button>
    </div>

    <!-- Mobile: hamburger + lang toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button id="lang-toggle-mobile" class="lang-toggle text-label-sm">
        <span data-lang="vi">EN</span>
        <span data-lang="en">VI</span>
      </button>
      <button id="mobile-menu-btn" class="p-2 text-on-background hover:bg-surface-variant rounded-sm transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-surface border-t-2 border-on-background">
    <div class="px-6 py-4 space-y-1">
      {navLinks.map(link => (
        <a href={link.href} class="block px-4 py-3 text-label-md font-label text-on-surface-variant hover:text-primary hover:bg-surface-variant rounded-sm transition-colors">
          <span data-lang="vi">{link.label}</span>
          <span data-lang="en">{link.labelEn}</span>
        </a>
      ))}
    </div>
  </div>
</nav>