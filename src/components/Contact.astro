const productOptions = [
  { value: '', label: 'Chọn sản phẩm cần tư vấn', labelEn: 'Select a product' },
  { value: 'Sticker', label: 'Sticker (Decal, Die-cut, Kiss-cut)', labelEn: 'Sticker (Decal, Die-cut, Kiss-cut)' },
  { value: 'Tem nhãn', label: 'Tem nhãn (Labels)', labelEn: 'Labels' },
  { value: 'Bao bì', label: 'Bao bì (Packaging)', labelEn: 'Packaging' },
  { value: 'Transfer Sticker', label: 'Transfer Sticker', labelEn: 'Transfer Sticker' },
  { value: 'Heatpress', label: 'Heatpress', labelEn: 'Heatpress' },
  { value: 'Metal/Hologram Sticker', label: 'Metal/Hologram Sticker', labelEn: 'Metal/Hologram Sticker' },
  { value: 'Khác', label: 'Hỗn hợp / Khác', labelEn: 'Mixed / Other' },
];
---

<section class="section-padding bg-surface" id="contact-form">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <!-- Section label -->
    <div class="text-center mb-4">
      <span class="section-label">
        <span data-lang="vi">Liên hệ</span>
        <span data-lang="en">Contact</span>
      </span>
    </div>

    <div class="text-center mb-12">
      <h2 class="section-title">
        <span data-lang="vi">Kết nối với tôi</span>
        <span data-lang="en">Get in Touch</span>
      </h2>
      <p class="font-body text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        <span data-lang="vi">Hãy kết nối với tôi để thảo luận về giải pháp in ấn cho thương hiệu của bạn</span>
        <span data-lang="en">Let's connect to discuss printing solutions for your brand</span>
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8">
      <!-- Contact info -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="font-heading text-headline-lg text-on-background mb-6">
          <span data-lang="vi">Thông tin liên hệ</span>
          <span data-lang="en">Contact Info</span>
        </h3>
        {contactInfo.map(info => (
          <a href={info.href} target="_blank" rel="noopener noreferrer"
             class="card-stitch-sm flex items-center gap-4 group">
            <span class="font-label text-label-md text-primary w-24 flex-shrink-0">
              <span data-lang="vi">{info.label}</span>
              <span data-lang="en">{info.labelEn}</span>
            </span>
            <span class="font-body text-body-md text-on-background group-hover:text-primary transition-colors">{info.value}</span>
          </a>
        ))}

        <div class="card-stitch mt-6">
          <h4 class="font-heading font-bold text-on-background mb-2">Sticker Factory</h4>
          <p class="font-body text-body-sm text-on-surface-variant">
            <span data-lang="vi">Công ty TNHH Nhà Máy Sticker<br />TP. Hồ Chí Minh, Việt Nam</span>
            <span data-lang="en">Sticker Factory Company Limited<br />Ho Chi Minh City, Vietnam</span>
          </p>
        </div>
      </div>

      <!-- Contact form -->
      <div class="lg:col-span-3">
        <h3 class="font-heading text-headline-lg text-on-background mb-6">
          <span data-lang="vi">Gửi tin nhắn</span>
          <span data-lang="en">Send a Message</span>
        </h3>
        <form id="contact-form-el" class="card-stitch space-y-5">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="font-label text-label-md text-on-surface-variant mb-2 block">
                <span data-lang="vi">Họ và tên</span>
                <span data-lang="en">Full Name</span>
                <span class="text-primary"> *</span>
              </label>
              <input type="text" name="name" required
                     class="input-stitch"
                     placeholder="Nhập họ và tên" />
            </div>
            <div>
              <label class="font-label text-label-md text-on-surface-variant mb-2 block">
                <span data-lang="vi">Số điện thoại</span>
                <span data-lang="en">Phone</span>
                <span class="text-primary"> *</span>
              </label>
              <input type="tel" name="phone" required
                     class="input-stitch"
                     placeholder="0xxx xxx xxx" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="font-label text-label-md text-on-surface-variant mb-2 block">
                <span data-lang="vi">Email</span>
                <span data-lang="en">Email</span>
                <span class="text-primary"> *</span>
              </label>
              <input type="email" name="email" required
                     class="input-stitch"
                     placeholder="email@example.com" />
            </div>
            <div>
              <label class="font-label text-label-md text-on-surface-variant mb-2 block">
                <span data-lang="vi">Sản phẩm cần tư vấn</span>
                <span data-lang="en">Product</span>
                <span class="text-primary"> *</span>
              </label>
              <select name="product" required class="input-stitch bg-surface">
                {productOptions.map(opt => (
                  <option value={opt.value}>
                    <span data-lang="vi">{opt.label}</span>
                    <span data-lang="en">{opt.labelEn}</span>
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label class="font-label text-label-md text-on-surface-variant mb-2 block">
              <span data-lang="vi">Nội dung</span>
              <span data-lang="en">Message</span>
              <span class="text-primary"> *</span>
            </label>
            <textarea name="message" rows="4" required
                      class="input-stitch resize-none"
                      placeholder="Viết tin nhắn của bạn..."></textarea>
          </div>

          <div>
            <label class="font-label text-label-md text-on-surface-variant mb-2 block">
              <span data-lang="vi">Hình ảnh đính kèm (tùy chọn)</span>
              <span data-lang="en">Attachment (optional)</span>
            </label>
            <div class="border-2 border-dashed border-on-background rounded-sm p-6 text-center hover:border-primary transition-colors cursor-pointer" id="drop-zone">
              <input type="file" id="file-input" name="image" accept="image/*" class="hidden" />
              <svg class="mx-auto w-8 h-8 text-on-surface-variant mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="font-body text-body-sm text-on-surface-variant">
                <span data-lang="vi">Kéo thả hoặc click để chọn hình (tối đa 5MB)</span>
                <span data-lang="en">Drag & drop or click to select (max 5MB)</span>
              </p>
              <p id="file-name" class="mt-2 font-label text-label-md text-primary hidden"></p>
              <p id="file-error" class="mt-2 font-label text-label-sm text-error hidden"></p>
            </div>
          </div>

          <button type="submit" id="submit-btn" class="btn-primary w-full">
            <span id="btn-text">
              <span data-lang="vi">Gửi tin nhắn</span>
              <span data-lang="en">Send Message</span>
            </span>
            <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>

          <div id="form-success" class="hidden p-4 bg-surface-container border-2 border-on-background rounded-sm text-on-background font-body text-body-md text-center">
            ✓ <span data-lang="vi">Gửi thành công! Tôi sẽ liên hệ lại với bạn sớm nhất có thể.</span>
            <span data-lang="en">Success! I'll get back to you as soon as possible.</span>
          </div>
          <div id="form-error" class="hidden p-4 bg-error-container border-2 border-error rounded-sm text-on-error-container font-body text-body-md text-center">
            ⚠ <span data-lang="vi">Đã xảy ra lỗi. Vui lòng thử lại hoặc liên hệ trực tiếp qua Zalo/WhatsApp.</span>
            <span data-lang="en">An error occurred. Please try again or contact via Zalo/WhatsApp.</span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form-el') as HTMLFormElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileNameEl = document.getElementById('file-name') as HTMLParagraphElement;
  const fileErrorEl = document.getElementById('file-error') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as SVGElement;
  const formSuccess = document.getElementById('form-success') as HTMLDivElement;
  const formError = document.getElementById('form-error') as HTMLDivElement;
  const MAX_SIZE = 5 * 1024 * 1024;

  let selectedFile: File | null = null;

  dropZone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', handleFileSelect);
  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-primary', 'bg-surface-variant');
  });
  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-primary', 'bg-surface-variant');
  });
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-primary', 'bg-surface-variant');
    const files = e.dataTransfer?.files;
    if (files?.length) handleFile(files[0]);
  });

  function handleFileSelect(e: Event) {
    const input = e.target as HTMLInputElement;
    if (input.files?.length) handleFile(input.files[0]);
  }

  function handleFile(file: File) {
    fileErrorEl.classList.add('hidden');
    fileNameEl.classList.add('hidden');
    selectedFile = null;
    if (!file.type.startsWith('image/')) {
      fileErrorEl.textContent = 'Chỉ chấp nhận file hình ảnh.';
      fileErrorEl.classList.remove('hidden');
      return;
    }
    if (file.size > MAX_SIZE) {
      fileErrorEl.textContent = 'File quá lớn. Vui lòng chọn hình nhỏ hơn 5MB.';
      fileErrorEl.classList.remove('hidden');
      return;
    }
    selectedFile = file;
    fileNameEl.textContent = `📎 ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
    fileNameEl.classList.remove('hidden');
  }

  async function compressImage(file: File, maxSizeKB = 500): Promise<File> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        let { width, height } = img;
        const maxDim = 1200;
        if (width > maxDim || height > maxDim) {
          if (width > height) {
            height = Math.round((height * maxDim) / width);
            width = maxDim;
          } else {
            width = Math.round((width * maxDim) / height);
            height = maxDim;
          }
        }
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob(
          (blob) => {
            if (!blob) { resolve(file); return; }
            if (blob.size <= maxSizeKB * 1024) { resolve(new File([blob], file.name, { type: blob.type })); return; }
            const scale = Math.sqrt((maxSizeKB * 1024) / blob.size);
            canvas.width = Math.round(width * scale);
            canvas.height = Math.round(height * scale);
            const ctx2 = canvas.getContext('2d')!;
            ctx2.drawImage(img, 0, 0, canvas.width, canvas.height);
            canvas.toBlob((b2) => resolve(new File([b2!], file.name, { type: b2!.type })), 'image/jpeg', 0.8);
          },
          'image/jpeg', 0.85
        );
      };
      img.onerror = () => resolve(file);
      img.src = url;
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formSuccess.classList.add('hidden');
    formError.classList.add('hidden');

    if (fileInput?.files?.[0] && fileInput.files[0].size > MAX_SIZE) {
      fileErrorEl.textContent = 'File quá lớn. Vui lòng chọn hình nhỏ hơn 5MB.';
      fileErrorEl.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    btnText.innerHTML = '<span data-lang="vi">Đang gửi...</span><span data-lang="en">Sending...</span>';
    btnSpinner.classList.remove('hidden');

    try {
      const formData = new FormData(form);
      const rawFile = formData.get('image') as File;
      if (rawFile && rawFile.size > 0) {
        const compressed = await compressImage(rawFile);
        formData.set('image', compressed);
      }

      const res = await fetch('https://nguyen-truong-thi-api.truongthi-nguyen.workers.dev/api/contact', {
        method: 'POST',
        body: formData,
      });

      if (res.ok) {
        form.reset();
        selectedFile = null;
        fileNameEl.classList.add('hidden');
        formSuccess.classList.remove('hidden');
      } else {
        const data = await res.json().catch(() => ({}));
        formError.textContent = data.error || 'Đã xảy ra lỗi. Vui lòng thử lại.';
        formError.classList.remove('hidden');
      }
    } catch {
      formError.textContent = 'Đã xảy ra lỗi. Vui lòng thử lại hoặc liên hệ trực tiếp qua Zalo/WhatsApp.';
      formError.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      btnText.innerHTML = '<span data-lang="vi">Gửi tin nhắn</span><span data-lang="en">Send Message</span>';
      btnSpinner.classList.add('hidden');
    }
  });
</script>