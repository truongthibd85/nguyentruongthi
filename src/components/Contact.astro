---
const contactInfo = [
  { label: 'Email', labelEn: 'Email', value: 'truongthi.nguyen@stickerfactory.vn', href: 'mailto:truongthi.nguyen@stickerfactory.vn', icon: 'mail' },
  { label: 'Điện thoại', labelEn: 'Phone', value: '0989 83 74 85', href: 'tel:+84989837485', icon: 'phone' },
  { label: 'Instagram', labelEn: 'Instagram', value: '@stickermanvn', href: 'https://www.instagram.com/stickermanvn', icon: 'camera' },
  { label: 'TikTok', labelEn: 'TikTok', value: '@stickermanvn', href: 'https://www.tiktok.com/@stickermanvn', icon: 'music_note' },
  { label: 'LinkedIn', labelEn: 'LinkedIn', value: 'Thi Nguyễn (Leon)', href: 'https://www.linkedin.com/in/nguyentruongthi', icon: 'link' },
  { label: 'Website', labelEn: 'Website', value: 'stickerfactory.vn', href: 'https://stickerfactory.vn', icon: 'language' },
];

const productOptions = [
  { value: '', label: 'Chọn sản phẩm cần tư vấn', labelEn: 'Select a product' },
  { value: 'Sticker', label: 'Sticker (Decal, Die-cut, Kiss-cut)', labelEn: 'Sticker (Decal, Die-cut, Kiss-cut)' },
  { value: 'Tem nhãn', label: 'Tem nhãn (Labels)', labelEn: 'Labels' },
  { value: 'Bao bì', label: 'Bao bì (Packaging)', labelEn: 'Packaging' },
  { value: 'Transfer Sticker', label: 'Transfer Sticker', labelEn: 'Transfer Sticker' },
  { value: 'Heatpress', label: 'Heatpress', labelEn: 'Heatpress' },
  { value: 'Metal/Hologram Sticker', label: 'Metal/Hologram Sticker', labelEn: 'Metal/Hologram Sticker' },
  { value: 'Khác', label: 'Hỗn hợp / Khác', labelEn: 'Mixed / Other' },
];
---

<section id="contact" class="py-16 lg:py-24 bg-surface-container">
  <div class="container-custom">
    <div class="text-center mb-12">
      <span class="section-label reveal">Liên hệ</span>
      <h2 class="section-title reveal mt-2">
        <span data-lang="vi">Kết nối với tôi</span>
        <span data-lang="en">Get in Touch</span>
      </h2>
      <p class="reveal font-body text-body-lg text-on-surface-variant max-w-2xl mx-auto mt-4">
        <span data-lang="vi">Hãy kết nối với tôi để thảo luận về giải pháp in ấn cho thương hiệu của bạn</span>
        <span data-lang="en">Let's connect to discuss printing solutions for your brand</span>
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 reveal">
      <!-- Contact info -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="font-heading font-bold text-xl text-on-surface mb-6">
          <span data-lang="vi">Thông tin liên hệ</span>
          <span data-lang="en">Contact Info</span>
        </h3>
        {contactInfo.map(info => (
          <a href={info.href} target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-4 p-4 bg-white rounded-xl shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 border border-border-muted group">
            <div class="w-10 h-10 bg-surface-container rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-primary text-xl">{info.icon}</span>
            </div>
            <div>
              <div class="font-body text-xs text-on-surface-variant font-semibold uppercase tracking-wider">
                <span data-lang="vi">{info.label}</span>
                <span data-lang="en">{info.labelEn}</span>
              </div>
              <div class="font-body text-sm text-on-surface group-hover:text-primary transition-colors">{info.value}</div>
            </div>
          </a>
        ))}

        <div class="p-6 bg-white rounded-xl shadow-sm border border-border-muted">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-white font-heading font-bold text-lg">SF</span>
            </div>
            <div>
              <div class="font-heading font-bold text-on-surface">Sticker Factory</div>
              <div class="font-body text-sm text-on-surface-variant">Công ty TNHH Nhà Máy Sticker</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="lg:col-span-3">
        <h3 class="font-heading font-bold text-xl text-on-surface mb-6">
          <span data-lang="vi">Gửi tin nhắn</span>
          <span data-lang="en">Send a Message</span>
        </h3>
        <form id="contact-form-el" class="bg-white rounded-2xl p-6 lg:p-8 shadow-lg border border-border-muted space-y-5">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="font-body text-sm font-semibold text-on-surface mb-2 block">
                <span data-lang="vi">Họ và tên</span>
                <span data-lang="en">Full Name</span>
                <span class="text-primary"> *</span>
              </label>
              <input type="text" name="name" required class="input-stitch" placeholder="Nhập họ và tên" />
            </div>
            <div>
              <label class="font-body text-sm font-semibold text-on-surface mb-2 block">
                <span data-lang="vi">Số điện thoại</span>
                <span data-lang="en">Phone</span>
                <span class="text-primary"> *</span>
              </label>
              <input type="tel" name="phone" required class="input-stitch" placeholder="0xxx xxx xxx" />
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="font-body text-sm font-semibold text-on-surface mb-2 block">
                <span data-lang="vi">Email</span>
                <span data-lang="en">Email</span>
                <span class="text-primary"> *</span>
              </label>
              <input type="email" name="email" required class="input-stitch" placeholder="email@example.com" />
            </div>
            <div>
              <label class="font-body text-sm font-semibold text-on-surface mb-2 block">
                <span data-lang="vi">Sản phẩm</span>
                <span data-lang="en">Product</span>
                <span class="text-primary"> *</span>
              </label>
              <select name="product" required class="input-stitch bg-white">
                {productOptions.map(opt => (
                  <option value={opt.value}>
                    <span data-lang="vi">{opt.label}</span>
                    <span data-lang="en">{opt.labelEn}</span>
                  </option>
                ))}
              </select>
            </div>
          </div>
          <div>
            <label class="font-body text-sm font-semibold text-on-surface mb-2 block">
              <span data-lang="vi">Nội dung</span>
              <span data-lang="en">Message</span>
              <span class="text-primary"> *</span>
            </label>
            <textarea name="message" rows="4" required class="input-stitch resize-none" placeholder="Viết tin nhắn của bạn..."></textarea>
          </div>
          <div>
            <label class="font-body text-sm font-semibold text-on-surface mb-2 block">
              <span data-lang="vi">Hình ảnh đính kèm (tùy chọn)</span>
              <span data-lang="en">Attachment (optional)</span>
            </label>
            <div class="border-2 border-dashed border-border-muted rounded-xl p-6 text-center hover:border-primary hover:bg-surface-container transition-all cursor-pointer" id="drop-zone">
              <input type="file" id="file-input" name="image" accept="image/*" class="hidden" />
              <span class="material-symbols-outlined text-4xl text-on-surface-variant mb-2">cloud_upload</span>
              <p class="font-body text-sm text-on-surface-variant">
                <span data-lang="vi">Kéo thả hoặc click để chọn hình (tối đa 5MB)</span>
                <span data-lang="en">Drag & drop or click to select (max 5MB)</span>
              </p>
              <p id="file-name" class="mt-2 font-body text-sm text-primary font-semibold hidden"></p>
              <p id="file-error" class="mt-2 font-body text-sm text-red-500 hidden"></p>
            </div>
          </div>
          <button type="submit" id="submit-btn" class="btn-primary w-full">
            <span id="btn-text" class="flex items-center gap-2">
              <span class="material-symbols-outlined">send</span>
              <span data-lang="vi">Gửi tin nhắn</span>
              <span data-lang="en">Send Message</span>
            </span>
            <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
          <div id="form-success" class="hidden p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 font-body text-sm text-center">
            ✓ <span data-lang="vi">Gửi thành công! Tôi sẽ liên hệ lại với bạn sớm nhất có thể.</span>
            <span data-lang="en">Success! I'll get back to you as soon as possible.</span>
          </div>
          <div id="form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 font-body text-sm text-center">
            ⚠ <span data-lang="vi">Đã xảy ra lỗi. Vui lòng thử lại hoặc liên hệ trực tiếp qua Zalo/WhatsApp.</span>
            <span data-lang="en">An error occurred. Please try again or contact via Zalo/WhatsApp.</span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form-el') as HTMLFormElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileNameEl = document.getElementById('file-name') as HTMLParagraphElement;
  const fileErrorEl = document.getElementById('file-error') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as SVGElement;
  const formSuccess = document.getElementById('form-success') as HTMLDivElement;
  const formError = document.getElementById('form-error') as HTMLDivElement;
  const MAX_SIZE = 5 * 1024 * 1024;

  dropZone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) handleFile(f);
  });
  dropZone?.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-primary', 'bg-surface-container'); });
  dropZone?.addEventListener('dragleave', () => { dropZone.classList.remove('border-primary', 'bg-surface-container'); });
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-primary', 'bg-surface-container');
    const f = e.dataTransfer?.files?.[0];
    if (f) handleFile(f);
  });

  function handleFile(file: File) {
    fileErrorEl.classList.add('hidden');
    fileNameEl.classList.add('hidden');
    if (!file.type.startsWith('image/')) {
      fileErrorEl.textContent = 'Chỉ chấp nhận file hình ảnh.';
      fileErrorEl.classList.remove('hidden');
      return;
    }
    if (file.size > MAX_SIZE) {
      fileErrorEl.textContent = 'File quá lớn. Vui lòng chọn hình nhỏ hơn 5MB.';
      fileErrorEl.classList.remove('hidden');
      return;
    }
    fileNameEl.textContent = `📎 ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
    fileNameEl.classList.remove('hidden');
  }

  async function compressImage(file: File): Promise<File> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        let { width, height } = img;
        const maxDim = 1200;
        if (width > maxDim || height > maxDim) {
          if (width > height) { height = Math.round((height * maxDim) / width); width = maxDim; }
          else { width = Math.round((width * maxDim) / height); height = maxDim; }
        }
        canvas.width = width; canvas.height = height;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob((blob) => {
          if (!blob) { resolve(file); return; }
          if (blob.size <= 500 * 1024) { resolve(new File([blob], file.name, { type: blob.type })); return; }
          const scale = Math.sqrt((500 * 1024) / blob.size);
          canvas.width = Math.round(width * scale); canvas.height = Math.round(height * scale);
          const ctx2 = canvas.getContext('2d')!;
          ctx2.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob((b2) => resolve(new File([b2!], file.name, { type: b2!.type })), 'image/jpeg', 0.8);
        }, 'image/jpeg', 0.85);
      };
      img.onerror = () => resolve(file);
      img.src = url;
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formSuccess.classList.add('hidden');
    formError.classList.add('hidden');
    submitBtn.disabled = true;
    btnText.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span><span data-lang="vi">Đang gửi...</span><span data-lang="en">Sending...</span>';
    btnSpinner.classList.remove('hidden');

    try {
      const formData = new FormData(form);
      const rawFile = formData.get('image') as File;
      if (rawFile && rawFile.size > 0) {
        const compressed = await compressImage(rawFile);
        formData.set('image', compressed);
      }
      const res = await fetch('https://nguyen-truong-thi-api.truongthi-nguyen.workers.dev/api/contact', { method: 'POST', body: formData });
      if (res.ok) {
        form.reset();
        fileNameEl.classList.add('hidden');
        formSuccess.classList.remove('hidden');
      } else {
        formError.classList.remove('hidden');
      }
    } catch {
      formError.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      btnText.innerHTML = '<span class="material-symbols-outlined">send</span><span data-lang="vi">Gửi tin nhắn</span><span data-lang="en">Send Message</span>';
      btnSpinner.classList.add('hidden');
    }
  });
</script>