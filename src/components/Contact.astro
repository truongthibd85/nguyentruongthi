---
const contactInfo = [
  {
    label: 'Email',
    value: 'truongthinguyen@stickerfactory.vn',
    href: 'mailto:truongthinguyen@stickerfactory.vn',
  },
  {
    label: 'Điện thoại',
    value: '0989 83 74 85',
    href: 'tel:+84989837485',
  },
  {
    label: 'Instagram',
    value: '@stickermanvn',
    href: 'https://www.instagram.com/stickermanvn',
  },
  {
    label: 'Facebook',
    value: 'Thi Nguyễn (Leon)',
    href: 'https://www.facebook.com/truongthivn',
  },
  {
    label: 'LinkedIn',
    value: 'Thi Nguyễn (Leon)',
    href: 'https://www.linkedin.com/in/nguyentruongthi',
  },
  {
    label: 'Website',
    value: 'stickerfactory.vn',
    href: 'https://stickerfactory.vn',
  },
];
---

<section class="section-padding bg-gray-50" id="contact-form">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="section-title">Liên hệ</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Hãy kết nối với tôi để thảo luận về giải pháp in ấn cho thương hiệu của bạn
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h3 class="font-heading text-xl font-bold mb-6">Thông tin liên hệ</h3>
        <div class="space-y-4">
          {contactInfo.map(info => (
            <a href={info.href} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-4 p-4 bg-white rounded-xl hover:shadow-md transition-shadow group">
              <span class="text-primary font-semibold text-sm w-20">{info.label}</span>
              <span class="text-gray-700 group-hover:text-primary transition-colors">{info.value}</span>
            </a>
          ))}
        </div>

        <div class="mt-8 p-6 bg-primary/5 rounded-xl">
          <h4 class="font-semibold mb-2">Sticker Factory</h4>
          <p class="text-gray-600 text-sm">
            Công ty TNHH Nhà Máy Sticker<br />
            TP. Hồ Chí Minh, Việt Nam
          </p>
        </div>
      </div>

      <div>
        <h3 class="font-heading text-xl font-bold mb-6">Gửi tin nhắn</h3>
        <form class="space-y-4" action="https://formspree.io/f/placeholder" method="POST">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Họ và tên</label>
            <input type="text" name="name" required
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-all"
                   placeholder="Nhập họ và tên của bạn" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
            <input type="email" name="email" required
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-all"
                   placeholder="email@example.com" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Nội dung</label>
            <textarea name="message" rows="4" required
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-all resize-none"
                      placeholder="Viết tin nhắn của bạn..."></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">
            Gửi tin nhắn
          </button>
        </form>
      </div>
    </div>
  </div>
</section>