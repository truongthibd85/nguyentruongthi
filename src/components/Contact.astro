  { value: 'Transfer Sticker', label: 'Transfer Sticker' },
  { value: 'Heatpress', label: 'Heatpress' },
  { value: 'Metal/Hologram Sticker', label: 'Metal/Hologram Sticker' },
  { value: 'Hỗn hợp / Khác', label: 'Hỗn hợp / Khác' },
];
---

<section class="section-padding bg-gray-50" id="contact-form">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="section-title">
        <span data-lang="vi">Liên hệ</span>
        <span data-lang="en">Contact</span>
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        <span data-lang="vi">Hãy kết nối với tôi để thảo luận về giải pháp in ấn cho thương hiệu của bạn</span>
        <span data-lang="en">Let's connect to discuss printing solutions for your brand</span>
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h3 class="font-heading text-xl font-bold mb-6">Thông tin liên hệ</h3>
        <div class="space-y-4">
          {contactInfo.map(info => (
            <a href={info.href} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-4 p-4 bg-white rounded-xl hover:shadow-md transition-shadow group">
              <span class="text-brand-red font-semibold text-sm w-20">{info.label}</span>
              <span class="text-gray-700 group-hover:text-brand-red transition-colors">{info.value}</span>
            </a>
          ))}
        </div>

        <div class="mt-8 p-6 bg-primary/5 rounded-xl">
          <h4 class="font-semibold mb-2">Sticker Factory</h4>
          <p class="text-gray-600 text-sm">
            Công ty TNHH Nhà Máy Sticker<br />
            TP. Hồ Chí Minh, Việt Nam
          </p>
        </div>
      </div>

      <div>
        <h3 class="font-heading text-xl font-bold mb-6">Gửi tin nhắn</h3>
        <form id="contact-form-el" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Họ và tên *</label>
            <input type="text" name="name" required
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-red/50 focus:border-primary outline-none transition-all"
                   placeholder="Nhập họ và tên của bạn" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Số điện thoại *</label>
            <input type="tel" name="phone" required
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-red/50 focus:border-primary outline-none transition-all"
                   placeholder="0xxx xxx xxx" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
            <input type="email" name="email" required
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-red/50 focus:border-primary outline-none transition-all"
                   placeholder="email@example.com" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Sản phẩm cần tư vấn *</label>
            <select name="product" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-red/50 focus:border-primary outline-none transition-all bg-white">
              {productOptions.map(opt => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Nội dung *</label>
            <textarea name="message" rows="4" required
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-red/50 focus:border-primary outline-none transition-all resize-none"
                      placeholder="Viết tin nhắn của bạn..."></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Hình ảnh đính kèm (tùy chọn)</label>
            <div class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-brand-red/50 transition-colors cursor-pointer" id="drop-zone">
              <input type="file" id="file-input" name="image" accept="image/*" class="hidden" />
              <svg class="mx-auto w-8 h-8 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm text-gray-500">Kéo thả hoặc click để chọn hình (tối đa 5MB)</p>
              <p id="file-name" class="mt-2 text-sm text-brand-red font-medium hidden"></p>
              <p id="file-error" class="mt-2 text-sm text-red-500 hidden"></p>
            </div>
          </div>

          <button type="submit" id="submit-btn" class="btn-primary w-full flex items-center justify-center gap-2">
            <span id="btn-text">Gửi tin nhắn</span>
            <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>

          <div id="form-success" class="hidden p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm text-center">
            ✓ Gửi thành công! Tôi sẽ liên hệ lại với bạn sớm nhất có thể.
          </div>
          <div id="form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm text-center">
            ⚠ Đã xảy ra lỗi. Vui lòng thử lại hoặc liên hệ trực tiếp qua Zalo/WhatsApp.
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form-el') as HTMLFormElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileNameEl = document.getElementById('file-name') as HTMLParagraphElement;
  const fileErrorEl = document.getElementById('file-error') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as SVGElement;
  const formSuccess = document.getElementById('form-success') as HTMLDivElement;
  const formError = document.getElementById('form-error') as HTMLDivElement;
  const MAX_SIZE = 5 * 1024 * 1024; // 5MB

  let selectedFile: File | null = null;

  // File selection handlers
  dropZone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', handleFileSelect);

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-primary', 'bg-orange-50/30');
  });
  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-primary', 'bg-orange-50/30');
  });
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-primary', 'bg-orange-50/30');
    const files = e.dataTransfer?.files;
    if (files?.length) handleFile(files[0]);
  });

  function handleFileSelect(e: Event) {
    const input = e.target as HTMLInputElement;
    if (input.files?.length) handleFile(input.files[0]);
  }

  function handleFile(file: File) {
    fileErrorEl.classList.add('hidden');
    fileNameEl.classList.add('hidden');
    selectedFile = null;

    if (!file.type.startsWith('image/')) {
      fileErrorEl.textContent = 'Chỉ chấp nhận file hình ảnh.';
      fileErrorEl.classList.remove('hidden');
      return;
    }

    if (file.size > MAX_SIZE) {
      fileErrorEl.textContent = 'File quá lớn. Vui lòng chọn hình nhỏ hơn 5MB.';
      fileErrorEl.classList.remove('hidden');
      return;
    }

    selectedFile = file;
    fileNameEl.textContent = `📎 ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
    fileNameEl.classList.remove('hidden');
  }

  // Image compression
  async function compressImage(file: File, maxSizeKB = 500): Promise<File> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        let { width, height } = img;
        const maxDim = 1200;
        if (width > maxDim || height > maxDim) {
          if (width > height) {
            height = Math.round((height * maxDim) / width);
            width = maxDim;
          } else {
            width = Math.round((width * maxDim) / height);
            height = maxDim;
          }
        }
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob(
          (blob) => {
            if (!blob) { resolve(file); return; }
            if (blob.size <= maxSizeKB * 1024 || file.size <= MAX_SIZE) { resolve(new File([blob], file.name, { type: blob.type })); return; }
            const scale = Math.sqrt((maxSizeKB * 1024) / blob.size);
            canvas.width = Math.round(width * scale);
            canvas.height = Math.round(height * scale);
            const ctx2 = canvas.getContext('2d')!;
            ctx2.drawImage(img, 0, 0, canvas.width, canvas.height);
            canvas.toBlob(
              (b2) => resolve(new File([b2!], file.name, { type: b2!.type })),
              'image/jpeg', 0.8
            );
          },
          'image/jpeg',
          0.85
        );
      };
      img.onerror = () => resolve(file);
      img.src = url;
    });
  }

  // Form submit
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formSuccess.classList.add('hidden');
    formError.classList.add('hidden');

    // Validate file
    if (fileInput?.files?.[0] && fileInput.files[0].size > MAX_SIZE) {
      fileErrorEl.textContent = 'File quá lớn. Vui lòng chọn hình nhỏ hơn 5MB.';
      fileErrorEl.classList.remove('hidden');
      return;
    }

    // Show loading
    submitBtn.disabled = true;
    btnText.textContent = 'Đang gửi...';
    btnSpinner.classList.remove('hidden');

    try {
      const formData = new FormData(form);

      // Compress image if exists
      const rawFile = formData.get('image') as File;
      if (rawFile && rawFile.size > 0) {
        const compressed = await compressImage(rawFile);
        formData.set('image', compressed);
      }

      const res = await fetch('https://nguyen-truong-thi-api.truongthi-nguyen.workers.dev/api/contact', {
        method: 'POST',
        body: formData,
      });

      if (res.ok) {
        form.reset();
        selectedFile = null;
        fileNameEl.classList.add('hidden');
        formSuccess.classList.remove('hidden');
      } else {
        const data = await res.json().catch(() => ({}));
        formError.textContent = data.error || 'Đã xảy ra lỗi. Vui lòng thử lại.';
        formError.classList.remove('hidden');
      }
    } catch {
      formError.textContent = 'Đã xảy ra lỗi. Vui lòng thử lại hoặc liên hệ trực tiếp qua Zalo/WhatsApp.';
      formError.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Gửi tin nhắn';
      btnSpinner.classList.add('hidden');
    }
  });
</script>