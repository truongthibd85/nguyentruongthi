---
const socialLinks = [
  { href: 'https://www.instagram.com/stickermanvn', label: 'Instagram', labelEn: 'Instagram', icon: 'camera' },
  { href: 'https://www.facebook.com/truongthivn', label: 'Facebook', labelEn: 'Facebook', icon: 'public' },
  { href: 'https://www.linkedin.com/in/nguyentruongthi', label: 'LinkedIn', labelEn: 'LinkedIn', icon: 'link' },
  { href: 'https://stickerfactory.vn', label: 'Website', labelEn: 'Website', icon: 'language' },
];
---

<footer class="bg-secondary text-white py-12">
  <div class="container-custom">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center">
            <span class="text-white font-heading font-bold text-sm">SF</span>
          </div>
          <h3 class="font-heading font-bold text-xl">Thi Nguyễn (Leon)</h3>
        </div>
        <p class="font-body text-sm text-white/70 leading-relaxed">
          <span data-lang="vi">Co-Founder & Partner Director tại Sticker Factory<br />TP. Hồ Chí Minh, Việt Nam</span>
          <span data-lang="en">Co-Founder & Partner Director at Sticker Factory<br />Ho Chi Minh City, Vietnam</span>
        </p>
      </div>

      <div>
        <h4 class="font-body font-semibold text-sm uppercase tracking-wider text-white/60 mb-4">
          <span data-lang="vi">Liên kết</span>
          <span data-lang="en">Links</span>
        </h4>
        <div class="flex flex-wrap gap-3">
          {socialLinks.map(link => (
            <a href={link.href} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 px-3 py-2 bg-white/10 rounded-lg text-sm font-body text-white/80 hover:bg-white/20 hover:text-white transition-all duration-200">
              <span class="material-symbols-outlined text-base">{link.icon}</span>
              <span data-lang="vi">{link.label}</span>
              <span data-lang="en">{link.labelEn}</span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="font-body font-semibold text-sm uppercase tracking-wider text-white/60 mb-4">
          <span data-lang="vi">Liên hệ</span>
          <span data-lang="en">Contact</span>
        </h4>
        <p class="font-body text-sm text-white/70">truongthinguyen@stickerfactory.vn</p>
        <p class="font-body text-sm text-white/70 mt-1">0989 83 74 85</p>
      </div>
    </div>

    <div class="divider bg-white/20 mb-6"></div>

    <div class="text-center">
      <p class="font-body text-sm text-white/50">
        &copy; 2024 Thi Nguyễn (Leon). All rights reserved.
      </p>
    </div>
  </div>
</footer>